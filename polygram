#!/usr/bin/env sh
# PolyGram launcher. Resolves the symlink created in ~/.local/bin so the
# command works from any directory, including when started as `PolyGram`.
set -eu

SELF=$0
if command -v readlink >/dev/null 2>&1; then
  RESOLVED=$(readlink -f -- "$SELF" 2>/dev/null || printf '%s' "$SELF")
else
  RESOLVED=$SELF
fi

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$RESOLVED")" && pwd)
exec python3 "$SCRIPT_DIR/polygram.py" "$@"
